# ─────────────────────────────────────────────────────────────────────────────
# CRE Finance Brief — environment configuration
#
# Copy this file to `.env` (which is git-ignored) and fill in real values to run
# locally. In GitHub Actions these are provided as repository **Secrets**, not
# from this file. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required for content generation -----------------------------------------

# Google Gemini API key — free tier, do NOT enable billing.
# Get one at: https://aistudio.google.com/apikey  ("Create API key")
GEMINI_API_KEY=

# FRED API key — free. Create a fredaccount.stlouisfed.org login, then:
# https://fredaccount.stlouisfed.org/apikeys  (32-char lowercase string)
FRED_API_KEY=

# --- Required only to actually SEND (omit for `--no-send` dry runs) -----------

# Comma-separated recipient list.
RECIPIENTS=you@example.com, colleague@example.com

# Choose ONE delivery method below (fill in one pair, leave the other blank).
# If both are set, Gmail is used unless you force a choice here:
#   DELIVERY_METHOD=resend   (or "gmail"; blank = auto-detect)
DELIVERY_METHOD=

# OPTION A — Gmail (recommended; NO domain needed) ----------------------------
# Send from your own Gmail. Turn on 2-Step Verification, then create an
# "App Password" at https://myaccount.google.com/apppasswords and paste the
# 16-character code below (spaces are fine). ~500 recipients/day.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional display name shown as the sender.
SENDER_NAME=CRE Finance Brief

# OPTION B — Resend (needs a domain you verify in Resend) ----------------------
# Leave these blank if you're using Gmail above.
RESEND_API_KEY=
# From-address on your verified Resend domain, e.g. "Name <brief@yourdomain.com>".
SENDER_EMAIL=

# --- Deliverability (optional but recommended; helps avoid the junk folder) ---
# A real inbox you monitor. Sets Reply-To AND (by default) the unsubscribe
# contact used for BOTH the List-Unsubscribe header and a visible "Unsubscribe"
# link in the email footer — together these are one of the strongest signals a
# spam filter uses to trust a sender. When someone clicks Unsubscribe you get an
# email FROM their address; remove that address from RECIPIENTS to stop it.
REPLY_TO=you@gmail.com
# Override the unsubscribe target: an email address, OR an https URL (e.g. a
# Google Form). If blank, REPLY_TO is used; if that's blank too, GMAIL_ADDRESS.
LIST_UNSUBSCRIBE=

# --- Optional (sensible defaults) --------------------------------------------

# Gemini model. Default is the rolling alias gemini-flash-latest (auto-tracks
# the current stable free-tier Flash, so it survives model deprecations).
# Pin a specific version if you prefer: gemini-3.5-flash, gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-flash-latest

# News look-back window in hours (default 36). Bump to ~72 on Mondays if you
# want to sweep up the prior Friday's stories.
NEWS_WINDOW_HOURS=36

# IANA timezone used for the subject-line date and footer timestamp.
# Default America/New_York (US Eastern).
BRIEF_TIMEZONE=America/New_York
